{
  "name": "uptimeforge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.1.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "next-themes": "0.4.6",
    "zod": "4.3.6",
    "lucide-react": "0.577.0",
    "clsx": "2.1.1",
    "tailwind-merge": "3.5.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "prettier": "3.8.1",
    "vitest": "5.0.3",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "tailwindcss": "4.2.1",
    "@tailwindcss/postcss": "4.2.1"
  }
}
