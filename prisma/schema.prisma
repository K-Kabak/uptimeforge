generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @db.Timestamptz(3)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  accounts      Account[]
  sessions      Session[]
  monitors      Monitor[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime @db.Timestamptz(3)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime @db.Timestamptz(3)

  @@unique([identifier, token])
}

enum MonitorStatus {
  PENDING
  UP
  DOWN
  PAUSED
}

model Monitor {
  id                   String        @id @default(cuid())
  userId               String
  name                 String
  url                  String
  normalizedUrl        String
  intervalMinutes      Int           @default(5)
  timeoutMs            Int           @default(10000)
  status               MonitorStatus @default(PENDING)
  configVersion        Int           @default(1)
  urlChangedAt         DateTime?     @db.Timestamptz(3)
  lastCheckedAt        DateTime?     @db.Timestamptz(3)
  nextCheckAt          DateTime?     @default(now()) @db.Timestamptz(3)
  lastResponseTimeMs   Int?
  lastHttpStatus       Int?
  consecutiveSuccesses Int           @default(0)
  consecutiveFailures  Int           @default(0)
  firstFailureAt       DateTime?     @db.Timestamptz(3)
  leaseToken           String?
  leaseExpiresAt       DateTime?     @db.Timestamptz(3)
  checks               Check[]
  jobs                 CheckJob[]
  incidents            Incident[]
  createdAt            DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @db.Timestamptz(3)
  user                 User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, normalizedUrl])
  @@index([userId])
  @@index([status, nextCheckAt])
}

enum CheckResult {
  SUCCESS
  HTTP_ERROR
  TIMEOUT
  DNS_ERROR
  TLS_ERROR
  CONNECTION_ERROR
  BLOCKED_TARGET
  INTERNAL_ERROR
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  CANCELLED
  FAILED
}

model CheckJob {
  id                String    @id @default(cuid())
  monitorId         String
  configVersion     Int
  source            String
  status            JobStatus @default(PENDING)
  scheduledAt       DateTime  @default(now()) @db.Timestamptz(3)
  leaseToken        String?
  leaseExpiresAt    DateTime? @db.Timestamptz(3)
  attempts          Int       @default(0)
  publishedAt       DateTime? @db.Timestamptz(3)
  providerMessageId String?
  publishToken      String?
  publishExpiresAt  DateTime? @db.Timestamptz(3)
  publishAttempts   Int       @default(0)
  createdAt         DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime  @updatedAt @db.Timestamptz(3)
  monitor           Monitor   @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  check             Check?

  @@index([monitorId, status])
  @@index([status, createdAt])
  @@index([status, publishedAt, publishExpiresAt])
}

model Check {
  id                 String      @id @default(cuid())
  monitorId          String
  jobId              String      @unique
  configVersion      Int
  startedAt          DateTime    @db.Timestamptz(3)
  finishedAt         DateTime    @db.Timestamptz(3)
  durationMs         Int
  result             CheckResult
  httpStatus         Int?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime    @default(now()) @db.Timestamptz(3)
  monitor            Monitor     @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  job                CheckJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  triggeredIncidents Incident[]  @relation("IncidentTrigger")
  resolvedIncidents  Incident[]  @relation("IncidentResolve")

  @@index([monitorId, startedAt, id])
  @@index([createdAt])
}

enum IncidentStatus {
  OPEN
  RESOLVED
}

model Incident {
  id               String         @id @default(cuid())
  monitorId        String
  configVersion    Int
  status           IncidentStatus @default(OPEN)
  startedAt        DateTime       @db.Timestamptz(3)
  resolvedAt       DateTime?      @db.Timestamptz(3)
  triggerCheckId   String?
  resolveCheckId   String?
  cause            String
  resolutionReason String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)
  monitor          Monitor        @relation(fields: [monitorId], references: [id], onDelete: Cascade)
  triggerCheck     Check?         @relation("IncidentTrigger", fields: [triggerCheckId], references: [id], onDelete: SetNull)
  resolveCheck     Check?         @relation("IncidentResolve", fields: [resolveCheckId], references: [id], onDelete: SetNull)

  @@index([monitorId, startedAt])
}
